# Copy this file to .env and fill in the required values before running:
#   cp .env.example .env
#   docker compose up -d

# ─── Optional: which version to run ──────────────────────────────────────────

# The published image tag. Leave unset to use the version pinned in
# docker-compose.yml, which is what a release ships with.
#
# Released versions are published as 1.3.0 and 1.3, and the newest stable one
# is also `latest`. A prerelease is published under its exact name only —
# 1.4.0-beta — and never moves `latest`, so following `latest` will not put you
# on a beta.
#
# Not for running an instance on: `edge` is rebuilt on every push to the
# beta branch (never main) and is overwritten in place, so two machines pulling it on
# the same day can be running different code.
#GHD_VERSION=1.3.0

# ─── Required ────────────────────────────────────────────────────────────────

# Public URL of the app (no trailing slash). Used in email links and SAML metadata.
BASE_URL=http://localhost:8080

# Secret used to sign AND encrypt session cookies. Generate with:
#   openssl rand -base64 32
# Minimum 32 characters — the server refuses to start below that. The signing
# and encryption keys are derived from this one value, so there is nothing else
# to configure. Changing it logs everyone out.
SESSION_SECRET=change-me-in-production-this-is-really-insecure

# Secret used to sign JWTs for API bearer tokens. Optional: if unset or under 32 bytes,
# a key is generated once and stored in the database. A long env value still wins,
# except that an example value from this repository (such as the one below) is
# ignored and the generated key is used instead; the server logs a warning.
# Generate with: openssl rand -base64 32
# JWT_SECRET=change-me-in-production

# ─── Email / SMTP (optional — notifications disabled when unset) ──────────────

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=secret
# SMTP_FROM=helpdesk@example.com
# Both SMTP_HOST and SMTP_FROM are needed; without them email is off.
# TLS: port 465 uses TLS from the first byte; any other port uses STARTTLS.
# With SMTP_PASSWORD set, TLS is required and a send fails if the server does
# not offer it. Without a password, plain SMTP is allowed only to a loopback,
# private (10/8, 172.16/12, 192.168/16) or fc00::/7 address.

# ─── Virus scanning (optional — off by default) ────────────────────────────────

# Off by default: `docker compose up` alone brings up only the database and
# the app, and skips a ~300 MB ClamAV signature download the common path may
# never need — see #297. To turn scanning on, uncomment both lines below:
#
# CLAMAV_ADDR=tcp://clamav:3310
# COMPOSE_PROFILES=antivirus
#
# clamav/clamav is published for linux/amd64 only; docker-compose.yml pins
# the service to that platform, so on an arm64 host (Apple Silicon) it runs
# under emulation rather than failing to pull. A signature scan of a 25 MB
# upload is not a hot path, so that cost is one this feature can afford.

# ─── Feature flags (optional) ────────────────────────────────────────────────

# Guest ticket submission is an admin setting, not an environment variable.
# Turn it on under Admin -> Settings.
# SLA_ENABLED=false

# Password attempts allowed per ACCOUNT per minute, and signup attempts per
# source address per minute. 0 disables both.
#
# Keyed on the email address being attacked rather than the network address, so
# it works the same whether or not you run behind a reverse proxy, and cannot
# be shaken off by rotating IPs. Forwarding headers are ignored everywhere.
#
# TOTP verification has its own, stricter budget that is not configurable.
#
# Counters are in memory and per process: restarting clears them, and each
# replica keeps its own.
# AUTH_RATE_LIMIT_PER_MINUTE=10
#
# How long a login (or a wrong current password on PATCH /me/password) for an
# account that has spent its failed-attempt budget waits before the password
# is checked. Protects against online brute-force
# guessing. Must be a valid duration (e.g. 1s, 1m); cannot be zero.
# AUTH_THROTTLE_DELAY=1s
# Two-factor authentication is an admin setting, not an environment
# variable. Turn it on under Admin -> Settings.

# ─── Logging (optional) ──────────────────────────────────────────────────────

# Log level: debug, info, warn, error (default: info)
# LOG_LEVEL=debug
